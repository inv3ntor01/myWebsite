---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer>
	<div class="footer-inner">
		<a class="footer-brand" href="/">{SITE_TITLE}<span>© {year}</span></a>
		<p>Curiosity, collected.</p>
		<a class="rss-link" href="/rss.xml">Follow along via RSS <span aria-hidden="true">↗</span></a>
	</div>
</footer>

<style>
	footer {
		padding: 26px 24px;
		border-top: 1px solid var(--line);
		background: #0e0f14;
	}

	.footer-inner {
		display: flex;
		width: min(1120px, 100%);
		align-items: center;
		justify-content: space-between;
		gap: 18px;
		margin: auto;
	}

	.footer-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		color: var(--paper);
		font-size: 0.8rem;
		font-weight: 700;
		text-decoration: none;
	}

	.footer-brand span,
	.footer-inner p {
		color: var(--muted);
		font-size: 0.72rem;
		font-weight: 400;
	}

	.footer-inner p {
		margin: 0;
	}

	.rss-link {
		color: var(--muted);
		font-size: 0.72rem;
		text-decoration: none;
	}

	.rss-link span {
		color: var(--mint);
	}

	.rss-link:hover {
		color: var(--paper);
	}

	@media (max-width: 600px) {
		.footer-inner {
			flex-wrap: wrap;
		}

		.footer-inner p {
			display: none;
		}
	}
</style>

---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="Main navigation">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} home`}>
			<span class="brand-mark" aria-hidden="true">S</span>
			<span class="brand-name">{SITE_TITLE}<small>Journal</small></span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/blog/">Writing</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<a class="rss-link" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
	</nav>
</header>

<style>
	header {
		padding: 0 24px;
		border-bottom: 1px solid var(--line);
		background: rgb(17 18 24 / 88%);
		backdrop-filter: blur(16px);
	}

	nav {
		display: flex;
		width: min(1120px, 100%);
		min-height: 76px;
		align-items: center;
		justify-content: space-between;
		gap: 28px;
		margin: auto;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 11px;
		color: var(--paper);
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 37px;
		height: 37px;
		align-items: center;
		justify-content: center;
		border: 1px solid rgb(187 167 255 / 48%);
		border-radius: 12px;
		background: linear-gradient(145deg, rgb(187 167 255 / 22%), rgb(124 245 197 / 9%));
		color: var(--paper);
		font-size: 1.15rem;
		font-weight: 700;
	}

	.brand-name {
		display: flex;
		flex-direction: column;
		font-size: 0.91rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.brand-name small {
		margin-top: 3px;
		color: var(--muted);
		font-size: 0.58rem;
		font-weight: 400;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 30px;
		margin-left: auto;
	}

	.internal-links :global(a) {
		padding: 8px 0;
		color: var(--muted);
		font-size: 0.8rem;
		text-decoration: none;
	}

	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--paper);
	}

	.internal-links :global(a.active) {
		text-decoration: underline;
		text-decoration-color: var(--mint);
		text-underline-offset: 7px;
	}

	.rss-link {
		padding: 8px 13px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--paper);
		font-size: 0.75rem;
		text-decoration: none;
	}

	.rss-link span {
		margin-left: 3px;
		color: var(--mint);
	}

	.rss-link:hover {
		border-color: var(--lavender);
		color: var(--lavender);
	}

	@media (max-width: 520px) {
		header {
			padding: 0 18px;
		}

		nav {
			min-height: 68px;
			gap: 14px;
		}

		.internal-links {
			gap: 14px;
		}

		.rss-link {
			display: none;
		}
	}
</style>
